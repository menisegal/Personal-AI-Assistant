TELEGRAM_BOT_TOKEN=your_bot_token_here
# Comma-separated "telegram_user_id:Name" entries. Add more people by appending
# more entries, e.g. "111111111:Alice,222222222:Bob" — everyone listed can use
# the bot in their own private conversation and shares the same task list.
AUTHORIZED_USERS=your_user_id_here:YourName

# LLM_PROVIDER selects the model backend: "gemini" (default), "claude", or "local".
# LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_google_api_key_here

# Only used when LLM_PROVIDER=claude (get a key at console.anthropic.com):
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Only used when LLM_PROVIDER=local (see requirements-local-llm.txt):
# LOCAL_LLM_MODEL_PATH=/data/models/qwen2.5-3b-instruct-q4_k_m.gguf
# LOCAL_LLM_N_CTX=4096
# LOCAL_LLM_N_THREADS=4

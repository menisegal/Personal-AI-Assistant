# Copy to deploy/deploy.env and fill in your Raspberry Pi connection details.
# deploy/deploy.env is gitignored — CLI flags passed to deploy.py always override these.

PI_HOST=raspberrypi.local
PI_USER=pi
# PI_PORT=22
# PI_SSH_KEY=C:/Users/you/.ssh/id_ed25519
# Use an absolute path (not ~/...) if you plan to install the systemd service with --service
PI_REMOTE_PATH=/home/pi/personal-ai-assistant
SERVICE_NAME=personal-ai-assistant
# Python interpreter used to create the venv on the Pi. Only needed if the
# system python3 is too old for requirements.txt (e.g. a custom-built Python).
# PYTHON_BIN=/data/python3.11/bin/python3.11
